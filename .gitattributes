###############################################################################
# 行尾策略：所有文本文件统一 LF 检出（Windows 含在内）。
# 显式锁定 eol 后，core.autocrlf=true 的机器执行 git add 不再出现
# "warning: in the future LF will be replaced by CRLF" 刷屏告警。
#
# Line-ending policy: all text files check out as LF (Windows included).
# Locking eol removes the autocrlf "LF will be replaced by CRLF" warning
# at the source instead of treating it as normal noise.
###############################################################################
* text=auto eol=lf

###############################################################################
# 二进制文件：禁止任何行尾转换 / Binary files: never convert
###############################################################################
*.a     binary
*.lib   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.dylib binary
*.so    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.zip   binary
*.gz    binary
*.pdf   binary
*.tar   binary
*.7z    binary
*.o     binary
*.obj   binary
*.bin   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary